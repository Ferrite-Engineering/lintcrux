<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>lintcrux</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>LintCrux Project File</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.lintcrux.project</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>lintcrux-workspace</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>LintCrux Workspace File</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.lintcrux.workspace</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>lintcrux-session</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>LintCrux Session File</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.lintcrux.session</string>
			</array>
		</dict>
		<!-- A named type for .sarif, declared below. Naming public.json here
			     made LintCrux a handler for every JSON file on the Mac, and
			     .sarif itself, which the system types dynamically, for none. -->
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>sarif</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>SARIF Lint Output</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.lintcrux.sarif</string>
			</array>
		</dict>
		<!-- Declared below for the same reason: public.source-code claimed
			     every source file, and none of these extensions. -->
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>v</string>
				<string>vh</string>
				<string>sv</string>
				<string>svh</string>
				<string>vhd</string>
				<string>vhdl</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>HDL Source File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.lintcrux.hdl-source</string>
			</array>
		</dict>
		<!-- macOS already types .f as Fortran source (with .for), and a
			     system declaration wins over an imported one, so this names
			     that type instead of every plain-text file. LintCrux refuses a
			     .for file with a message. -->
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>f</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>Vivado Filelist</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.fortran-source</string>
			</array>
		</dict>
		<dict>
			<!-- The suite design manifest, named <design>.crux-project. Opening
			     one opens the lint project its `lint:` entry names. -->
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>crux-project</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>EDACrux Design Manifest</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>app.edacrux.project</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<!-- Imported: SARIF is an OASIS format, not LintCrux's. -->
			<key>UTTypeIdentifier</key>
			<string>com.lintcrux.sarif</string>
			<key>UTTypeDescription</key>
			<string>SARIF Lint Output</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>sarif</string>
				</array>
			</dict>
		</dict>
		<dict>
			<!-- Imported: Verilog, SystemVerilog and VHDL sources. -->
			<key>UTTypeIdentifier</key>
			<string>com.lintcrux.hdl-source</string>
			<key>UTTypeDescription</key>
			<string>HDL Source File</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.source-code</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>v</string>
					<string>vh</string>
					<string>sv</string>
					<string>svh</string>
					<string>vhd</string>
					<string>vhdl</string>
				</array>
			</dict>
		</dict>
		<dict>
			<!-- Imported, not exported: the manifest format belongs to the
			     suite, not to LintCrux. -->
			<key>UTTypeIdentifier</key>
			<string>app.edacrux.project</string>
			<key>UTTypeDescription</key>
			<string>EDACrux Design Manifest</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.yaml</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>crux-project</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.lintcrux.project</string>
			<key>UTTypeDescription</key>
			<string>LintCrux Project File</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<string>lintcrux</string>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.lintcrux.workspace</string>
			<key>UTTypeDescription</key>
			<string>LintCrux Workspace File</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<string>lintcrux-workspace</string>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.lintcrux.session</string>
			<key>UTTypeDescription</key>
			<string>LintCrux Session File</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<string>lintcrux-session</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
