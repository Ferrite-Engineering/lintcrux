{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "verible",
          "rules": [
            {
              "id": "no-tabs",
              "name": "no-tabs",
              "shortDescription": {
                "text": "no-tabs"
