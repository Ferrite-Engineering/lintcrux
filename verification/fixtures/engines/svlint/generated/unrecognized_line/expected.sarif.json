      "results": [
        {
          "ruleId": "keyword_forbidden_generate",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "Remove `generate`/`endgenerate` keywords."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/work/top.sv"
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "svlint.reason": "Keywords `generate`/`endgenerate` do not change semantics of generate blocks.",
            "svlint.context": [
              " generate"
            ]
          }
        }
      ]
    }
  ]
}
