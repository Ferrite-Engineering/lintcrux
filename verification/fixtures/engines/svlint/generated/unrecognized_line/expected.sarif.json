{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "svlint",
          "rules": [
            {
              "id": "keyword_forbidden_generate",
              "name": "keyword_forbidden_generate",
              "shortDescription": {
                "text": "keyword_forbidden_generate"
              },
              "helpUri": "https://github.com/dalance/svlint/blob/master/MANUAL.md#keyword_forbidden_generate",
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "startTimeUtc": "1970-01-01T00:00:00.000Z",
