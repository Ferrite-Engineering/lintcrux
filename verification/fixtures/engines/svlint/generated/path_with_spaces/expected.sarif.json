{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "svlint"
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "startTimeUtc": "1970-01-01T00:00:00.000Z",
          "endTimeUtc": "1970-01-01T00:00:00.000Z"
        }
      ],
      "automationDetails": {
        "id": "gen/svlint/path_with_spaces"
      },
      "results": [
        {
          "ruleId": "tab_character",
          "level": "warning",
          "message": {
            "text": "Replace tab with spaces."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/work/a dir/x.sv"
                },
                "region": {
                  "startLine": 3,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "svlint.reason": "Tabs may cause misalignment.",
            "svlint.context": [
              " \tlogic q;"
            ]
          }
        }
      ]
    }
  ]
}
