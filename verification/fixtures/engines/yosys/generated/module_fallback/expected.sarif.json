{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "yosys",
          "rules": [
            {
              "id": "found-multiply-driven-net",
              "name": "found-multiply-driven-net",
              "shortDescription": {
                "text": "found-multiply-driven-net"
              },
              "helpUri": "https://yosyshq.readthedocs.io/projects/yosys/en/latest/cmd/check.html#found-multiply-driven-net",
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "startTimeUtc": "1970-01-01T00:00:00.000Z",
          "endTimeUtc": "1970-01-01T00:00:00.000Z"
        }
      ],
      "automationDetails": {
        "id": "gen/yosys/module_fallback"
      },
      "results": [
        {
          "ruleId": "found-multiply-driven-net",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "Found multiply driven net \\q in module \\regfile"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "<module:q>"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "yosys.severityRaw": "warning",
            "yosys.rawLine": "Warning: Found multiply driven net \\q in module \\regfile"
          }
        }
      ]
    }
  ]
}
